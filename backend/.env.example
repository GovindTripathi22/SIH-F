# Application Settings
APP_NAME=UrbanPulse Backend
DEBUG=False
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/urbanpulse
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Authentication
SECRET_KEY=change-this-in-production-use-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Priority Engine Weights (must sum to 1.0)
PRIORITY_CONFIDENCE_WEIGHT=0.20
PRIORITY_OBSERVATION_WEIGHT=0.25
PRIORITY_BUS_DIVERSITY_WEIGHT=0.20
PRIORITY_RECURRENCE_WEIGHT=0.15
PRIORITY_SEVERITY_WEIGHT=0.10
PRIORITY_AGE_WEIGHT=0.10

# Spatial Thresholds
SPATIAL_CLUSTER_RADIUS_METERS=15.0
TEMPORAL_CLUSTER_WINDOW_MINUTES=30
MIN_OBSERVATIONS_FOR_VERIFICATION=2

# API Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
